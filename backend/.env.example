PORT=4000
NODE_ENV=development
# Prefer Atlas in real use. Always include the database name in the path:
#   mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/xkwisit?appName=XkwisitCluster
# Local only for offline work:
#   mongodb://127.0.0.1:27017/xkwisit
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/xkwisit?appName=XkwisitCluster
# Optional safety net — forces the DB name even if the URI path is missing (avoids Mongo's default "test")
MONGODB_DB_NAME=xkwisit
CORS_ORIGIN=http://localhost:3000
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
COOKIE_SECURE=false
# Comma-separated emails that receive platform Super Admin on register/login (server-side only)
PLATFORM_ADMIN_EMAILS=
